---
import DemoForm from "./Contact/DemoForm.astro";
import ErpMockup from "./usables/ErpMockup.astro";
import { useErpCopy } from "../i18n/erp";
import { whatsapp, type Lang } from "../i18n/ui";
interface Props { lang?: Lang; }
const { lang = "pt" } = Astro.props;
const copy = useErpCopy(lang);
const whatsappHref = `${whatsapp.link}?text=${encodeURIComponent(lang === "pt" ? "Olá! Gostaria de conhecer o Scalyns ERP para minha empresa." : "Hi! I would like to learn about Scalyns ERP for my company.")}`;
---
<section class="relative overflow-hidden bg-gradient-to-br from-primary via-[#142a3a] to-secondary pb-16 pt-28 text-white md:pb-24 md:pt-36">
  <div class="pointer-events-none absolute -right-24 top-16 size-96 rounded-full bg-emerald-500/10 blur-3xl" aria-hidden="true"></div>
  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-6 lg:grid-cols-[1.05fr_1fr]">
    <div><span class="inline-flex rounded-full border border-emerald-400/20 bg-emerald-400/5 px-4 py-2 text-xs font-semibold uppercase tracking-[0.15em] text-emerald-300">{copy.eyebrow}</span><h1 class="mt-6 font-title text-4xl font-bold leading-tight md:text-[2.9rem]">{copy.title}</h1><p class="mt-6 text-base leading-relaxed text-white/75 md:text-lg">{copy.subtitle}</p><div class="mt-8 flex flex-wrap gap-3"><a href="#contato" class="rounded-full bg-white px-6 py-3 text-sm font-semibold text-primary shadow-lg transition hover:-translate-y-0.5 hover:bg-gray-100">{copy.demoCta}</a><a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/25 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10">{copy.specialistCta}</a></div></div>
    <ErpMockup lang={lang} />
  </div>
</section>
<section class="bg-surface py-16 lg:py-20"><div class="mx-auto max-w-6xl px-6"><h2 class="mx-auto max-w-3xl text-center font-title text-2xl text-white md:text-3xl">{copy.problemTitle}</h2><ul class="mt-9 grid gap-4 sm:grid-cols-2">{copy.problems.map((problem) => <li class="rounded-2xl border border-amber-400/15 bg-amber-400/[0.04] p-5 text-sm leading-relaxed text-white/75"><span class="mr-2 text-amber-300" aria-hidden="true">—</span>{problem}</li>)}</ul></div></section>
<section id="recursos" class="py-16 lg:py-20"><div class="mx-auto max-w-6xl px-6"><h2 class="text-center font-title text-2xl text-white md:text-3xl">{copy.featuresTitle}</h2><ul class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">{copy.features.map((feature, index) => <li class="rounded-2xl border border-white/10 bg-white/[0.04] p-6 transition hover:border-emerald-400/30"><span class="text-xs font-semibold text-emerald-400">{String(index + 1).padStart(2, "0")}</span><h3 class="mt-4 font-semibold text-white">{feature.title}</h3><p class="mt-3 text-sm leading-relaxed text-white/65">{feature.description}</p></li>)}</ul></div></section>
<section class="bg-surface py-16 lg:py-20"><div class="mx-auto grid max-w-6xl items-center gap-12 px-6 lg:grid-cols-2"><div><h2 class="font-title text-3xl text-white">{copy.dashboardTitle}</h2><p class="mt-5 leading-relaxed text-white/70">{copy.dashboardText}</p><ul class="mt-6 space-y-3 text-sm text-white/80">{copy.dashboardPoints.map((point) => <li class="flex gap-3"><span class="text-emerald-400" aria-hidden="true">✓</span>{point}</li>)}</ul></div><ErpMockup lang={lang} /></div></section>
<section class="py-16 lg:py-20"><div class="mx-auto max-w-3xl px-6 text-center"><span class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-400">Scalyns CRM + ERP</span><h2 class="mt-4 font-title text-3xl text-white">{copy.ecosystemTitle}</h2><p class="mt-5 leading-relaxed text-white/70">{copy.ecosystemText}</p><a class="mt-6 inline-block text-sm font-semibold text-sky-300 underline underline-offset-4" href={lang === "pt" ? "/crm" : "/en/crm"}>{copy.crmCta}</a></div></section>
<section class="bg-surface py-16 lg:py-20"><div class="mx-auto max-w-3xl px-6"><h2 class="text-center font-title text-3xl text-white">{copy.faqTitle}</h2><div class="mt-8 space-y-3">{copy.faq.map((item) => <details class="group rounded-xl border border-white/10 bg-white/[0.04] p-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold text-white">{item.q}<span class="text-emerald-300 transition group-open:rotate-45" aria-hidden="true">+</span></summary><p class="mt-4 text-sm leading-relaxed text-white/70">{item.a}</p></details>)}</div></div></section>
<section id="contato" class="py-16 lg:py-24"><div class="mx-auto grid max-w-6xl items-start gap-12 px-6 lg:grid-cols-2"><div><h2 class="font-title text-3xl text-white md:text-4xl">{copy.demoTitle}</h2><p class="mt-5 leading-relaxed text-white/75">{copy.demoText}</p><ol class="mt-8 space-y-4">{copy.steps.map((step, index) => <li class="flex items-center gap-3 text-sm text-white/80"><span class="flex size-8 shrink-0 items-center justify-center rounded-full border border-emerald-400/20 bg-emerald-400/10 text-xs font-semibold text-emerald-300">{index + 1}</span>{step}</li>)}</ol><a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="mt-8 inline-block text-sm font-semibold text-emerald-300 underline underline-offset-4">{copy.specialistCta}</a></div><DemoForm lang={lang} product="erp" id="scalynsErpDemoForm" title={copy.demoFormTitle} /></div></section>
