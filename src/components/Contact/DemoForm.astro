---
import { useTranslations, type Lang } from "../../i18n/ui";
import TurnstileLoader from "./TurnstileLoader.astro";

interface Props {
  lang?: Lang;
  id?: string;
  title?: string;
  product?: "crm" | "erp";
}

const { lang = "pt", id = "scalynsDemoForm", title, product = "crm" } = Astro.props;
const t = useTranslations(lang);
const f = t.contact.form;

const WORKER_URL = "https://lead-gateway.matheus-hygino.workers.dev";
const DEMO_API_URL = product === "erp" ? import.meta.env.PUBLIC_ERP_DEMO_API_URL ?? "https://erp-demo.scalyns.cloud" : import.meta.env.PUBLIC_DEMO_API_URL ?? "https://demo.scalyns.cloud";
const TURNSTILE_SITE_KEY = "0x4AAAAAACBtETYrmppk61_g";
const FORM_ID = "scalyns";
const subject = lang === "pt" ? `Quero testar o Scalyns ${product.toUpperCase()}` : `I would like to try Scalyns ${product.toUpperCase()}`;
const notice = lang === "pt" ? `Acesso automático por 1 hora ao Scalyns ${product.toUpperCase()}, com dados fictícios. Administração, convites e conexões externas bloqueados.` : `Automatic 1-hour access to Scalyns ${product.toUpperCase()} with fictional data. Administration, invitations and external connections are blocked.`;
const messages = { fast: f.errors.fast, phone: f.errors.phone, consent: f.errors.consent, captcha: f.errors.captcha, captchaLoad: f.errors.captchaLoad, worker: f.errors.worker, generic: f.errors.generic, unknown: f.errors.unknown, sending: f.sending, success: f.success, submit: f.demoSubmit, redirecting: f.demoRedirecting, busy: f.demoBusy, unavailable: f.demoUnavailable, retry: f.demoRetry };
---

<div class="rounded-2xl border border-white/10 bg-white/[0.04] p-6 shadow-xl shadow-black/30 md:p-8">
  <h3 class="mb-2 text-center font-title text-xl font-semibold text-white">{title ?? f.title}</h3>
  <p class="mb-5 text-center text-xs leading-relaxed text-sky-300">{notice}</p>

  <form id={id} data-demo-form data-worker-url={WORKER_URL} data-demo-api={DEMO_API_URL} data-demo-product={product} data-demo-locale={lang === "pt" ? "pt-BR" : "en"} data-sitekey={TURNSTILE_SITE_KEY} data-validate-phone={lang === "pt" ? "true" : "false"} data-messages={JSON.stringify(messages)} method="POST" class="space-y-4" novalidate>
    <input type="hidden" name="form_id" value={FORM_ID} />
    <input type="hidden" name="formSource" value={`${product}-demo`} />
    <input type="hidden" name="subject" value={subject} />
    <input type="hidden" name="ts_loaded" />
    <input type="hidden" name="submittedAt" />

    <div class="hidden">
      <label for={`${id}-website`}>Website</label>
      <input type="text" id={`${id}-website`} name="company_website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      <input
        type="text"
        name="firstName"
        aria-label={f.firstName}
        placeholder={f.firstName}
        required
        autocomplete="given-name"
        class="w-full rounded-lg border border-white/10 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-500 outline-none transition focus:border-sky-400 focus:ring-2 focus:ring-sky-400/30"
      />
      <input
        type="text"
        name="lastName"
        aria-label={f.lastName}
        placeholder={f.lastName}
        required
        autocomplete="family-name"
        class="w-full rounded-lg border border-white/10 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-500 outline-none transition focus:border-sky-400 focus:ring-2 focus:ring-sky-400/30"
      />
    </div>

    <input
      type="email"
      name="email"
      aria-label={f.email}
      placeholder={f.email}
      required
      autocomplete="email"
      class="w-full rounded-lg border border-white/10 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-500 outline-none transition focus:border-sky-400 focus:ring-2 focus:ring-sky-400/30"
    />

    <input
      type="tel"
      name="phone"
      aria-label={f.phone}
      placeholder={f.phone}
      required
      inputmode="tel"
      autocomplete="tel"
      class="w-full rounded-lg border border-white/10 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-500 outline-none transition focus:border-sky-400 focus:ring-2 focus:ring-sky-400/30"
    />

    <textarea
      name="message"
      aria-label={f.message}
      rows="3"
      placeholder={f.message}
      class="w-full rounded-lg border border-white/10 bg-white px-4 py-2.5 text-sm text-slate-900 placeholder-slate-500 outline-none transition focus:border-sky-400 focus:ring-2 focus:ring-sky-400/30"
    ></textarea>

    <label class="flex items-start gap-2 text-sm text-white/75">
      <input type="checkbox" name="consent" required class="mt-0.5 h-4 w-4 rounded border-gray-300 text-primary" />
      <span>{f.consent}</span>
    </label>

    <div id={`${id}-turnstile`} class="flex min-h-[65px] justify-center"></div>

    <button
      type="submit"
      data-submit-button
      class="w-full rounded-lg bg-primary px-6 py-3 text-sm font-semibold uppercase tracking-wide text-white transition hover:bg-dark disabled:opacity-60"
    >
      {f.demoSubmit}
    </button>

    <p id={`${id}-result`} data-result class="mt-2 hidden text-center text-sm text-white/70" role="status" aria-live="polite"></p>
    <a data-demo-followup href={`${f.thanksUrl}?source=${product}-demo`} class="hidden text-center text-sm font-semibold text-sky-300 underline underline-offset-4">{f.demoFollowup}</a>
    <p class="text-center text-xs text-white/45">{f.privacy}</p>
  </form>
</div>

<TurnstileLoader />

<script>
  import { initializeDemoForms } from "./demo-form";
  if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initializeDemoForms, { once: true });
  else initializeDemoForms();
</script>
