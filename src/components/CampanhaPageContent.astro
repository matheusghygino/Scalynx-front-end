---
import ContactForm from "./Contact/ContactForm.astro";
import { contact, whatsapp } from "../i18n/ui";

const source = "campanha-seja-encontrado";
const whatsappMessage = "Olá! Vi a campanha da Scalyns e quero saber como aparecer no Google para o meu negócio.";
const whatsappHref = `${whatsapp.link}?text=${encodeURIComponent(whatsappMessage)}`;

const icons: Record<string, string> = {
  globe: '<circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3Z"></path>',
  pin: '<path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z"></path><circle cx="12" cy="10" r="2.6"></circle>',
  target: '<circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.4"></circle>',
  chat: '<path d="M21 12a8 8 0 0 1-8 8H5l-2 2V12a9 9 0 0 1 9-9h1a8 8 0 0 1 8 8Z"></path><path d="M8 11h8M8 15h5"></path>',
  calendar: '<rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 11h18"></path>',
  search: '<circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>',
  phone: '<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8 10a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"></path>',
  clock: '<circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>',
  check: '<path d="M5 13l4 4L19 7"></path>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"></path>',
};

const stats = [
  { value: "7 dias", label: "para o site profissional entrar no ar" },
  { value: "US$ 497", label: "valor inicial dos pacotes" },
  { value: "15 min", label: "para ver como ficaria para o seu negócio" },
  { value: "100%", label: "atendimento direto em português" },
];

const problems = [
  {
    icon: "calendar",
    title: "Agenda imprevisível",
    description: "Quando as indicações diminuem, o telefone para junto. Você fica refém de quem lembra de você naquele mês.",
  },
  {
    icon: "search",
    title: "O cliente pesquisa antes de ligar",
    description: "Ele abre o Google e procura pelo serviço na sua cidade. Se não encontra você, encontra o concorrente em segundos.",
  },
  {
    icon: "phone",
    title: "Contato perdido não volta",
    description: "Uma ligação não atendida, uma mensagem sem resposta e uma oportunidade que vai para outra empresa.",
  },
];

const solutions = [
  {
    icon: "globe",
    title: "Site profissional em 7 dias",
    description: "Seu negócio com presença própria, rápido e pronto para transformar visitas em contatos.",
    points: ["No ar em até 7 dias", "Ligado ao WhatsApp e e-mail", "Conectado ao CRM desde o início"],
  },
  {
    icon: "pin",
    title: "Google Local Services",
    description: "Apareça em destaque na busca local para quem já está pronto para contratar.",
    points: ["Destaque no topo do Google", "Você paga por contato recebido", "Foco em serviços da sua região"],
  },
  {
    icon: "target",
    title: "Anúncios no Google",
    description: "Campanhas para o que seu cliente digita quando precisa exatamente do seu serviço.",
    points: ["Palavras-chave da sua cidade", "Acompanhamento de cada ligação", "Otimização contínua por dados"],
  },
  {
    icon: "chat",
    title: "CRM simples",
    description: "Todos os contatos e conversas organizados para responder rápido e fazer follow-up.",
    points: ["Contatos em um só lugar", "Histórico de cada conversa", "Nenhum follow-up esquecido"],
  },
];

const steps = [
  {
    title: "Conversa de 15 minutos",
    description: "Entendemos seu serviço, sua cidade e como você atende hoje. Mostramos como ficaria para o seu negócio.",
  },
  {
    title: "Estrutura no ar em 7 dias",
    description: "Site profissional, integrações com WhatsApp, e-mail e CRM, além da configuração das campanhas.",
  },
  {
    title: "Contatos chegando e organizados",
    description: "Você recebe os contatos, responde rápido e acompanha tudo em um só lugar.",
  },
];

const offerItems = [
  "Site profissional + WhatsApp + e-mail + CRM",
  "Google Local Services e Google Ads",
  "Rastreamento de ligações e contatos",
  "Atendimento direto em português",
  "Sem contrato longo",
  "Diagnóstico de 15 minutos",
];

const faqs = [
  {
    q: "Preciso já ter um site para começar?",
    a: "Não. Criamos um site profissional pronto em até 7 dias, já ligado ao seu WhatsApp, e-mail e CRM.",
  },
  {
    q: "O que é o Google Local Services?",
    a: "É o formato do Google para serviços locais: seu negócio aparece em destaque na busca e você paga por contato recebido, não por clique.",
  },
  {
    q: "Funciona para o meu tipo de negócio?",
    a: "Se o seu cliente pesquisa pelo serviço antes de contratar — como encanamento, elétrica, limpeza, construção, beleza ou reparos — faz sentido. Avaliamos isso na conversa de 15 minutos.",
  },
  {
    q: "Em quanto tempo vejo resultados?",
    a: "A estrutura fica no ar em até 7 dias após o briefing. Os primeiros contatos variam conforme sua região, serviço e orçamento de mídia; acompanhamos as campanhas para ajustar.",
  },
  {
    q: "Preciso assinar contrato longo?",
    a: "Não. Os pacotes começam em US$ 497, sem contrato longo, com atendimento direto em português.",
  },
  {
    q: "Vocês atendem brasileiros em qualquer cidade dos EUA?",
    a: "Sim. Atendemos pequenos negócios brasileiros nos EUA e no Brasil, de forma remota e em português.",
  },
];
---

<section class="relative overflow-hidden bg-gradient-to-br from-primary via-[#1b2145] to-secondary pb-16 pt-28 text-white md:pb-24 md:pt-36">
  <div class="pointer-events-none absolute -left-40 top-10 size-[420px] rounded-full bg-sky-500/10 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-32 bottom-0 size-[380px] rounded-full bg-fuchsia-500/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-6 lg:grid-cols-[1.05fr_1fr]">
    <div>
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-white/75">
        Scalyns · Para brasileiros nos EUA
      </span>

      <p data-campaign-greeting class="mt-5 hidden text-sm font-semibold text-sky-300">
        Olá, <span data-campaign="nome"></span>! Tudo bem?
      </p>

      <h1 class="mt-4 max-w-xl text-4xl font-title font-bold leading-tight text-white md:text-[2.9rem]">
        Seu próximo cliente procura por
        <span class="text-sky-300" data-campaign="servico">seu serviço</span>
        em
        <span class="text-sky-300" data-campaign="cidade">sua cidade</span>.
        <span class="mt-2 block">Ele encontra você?</span>
      </h1>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-white/80 md:text-lg">
        Você saiu do Brasil, começou do zero e hoje depende de indicação para encher a agenda. A Scalyns ajuda pequenos
        negócios brasileiros a serem encontrados no Google — e a não perder nenhum contato.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="#contato" class="rounded-full bg-white px-7 py-3 font-semibold text-primary shadow-lg shadow-black/20 transition hover:-translate-y-0.5 hover:bg-gray-100">
          Quero ser encontrado no Google
        </a>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          data-campaign-whatsapp
          class="rounded-full border border-white/30 px-7 py-3 font-semibold text-white transition hover:bg-white/10"
        >
          Falar no WhatsApp
        </a>
      </div>

      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-xs text-white/60">
        <li class="flex items-center gap-1.5"><span class="text-emerald-400">✓</span> Site no ar em 7 dias</li>
        <li class="flex items-center gap-1.5"><span class="text-emerald-400">✓</span> Sem contrato longo</li>
        <li class="flex items-center gap-1.5"><span class="text-emerald-400">✓</span> Atendimento em português</li>
      </ul>

      <dl class="mt-10 grid max-w-xl grid-cols-2 gap-x-6 gap-y-5 border-t border-white/10 pt-8 sm:grid-cols-4">
        {stats.map((stat) => (
          <div>
            <dt class="text-2xl font-title font-bold text-white">{stat.value}</dt>
            <dd class="mt-1 text-xs leading-snug text-white/60">{stat.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="relative mx-auto w-full max-w-md pb-24">
      <div class="overflow-hidden rounded-2xl border border-white/10 bg-[#0e1326] shadow-2xl shadow-black/50">
        <div class="flex items-center gap-2 border-b border-white/5 px-4 py-2.5">
          <div class="flex gap-1.5">
            <span class="size-2 rounded-full bg-red-400/70"></span>
            <span class="size-2 rounded-full bg-amber-400/70"></span>
            <span class="size-2 rounded-full bg-emerald-400/70"></span>
          </div>
          <div class="ml-2 flex min-w-0 flex-1 items-center gap-2 rounded-md bg-white/5 px-3 py-1.5 text-[11px] text-white/60">
            <svg viewBox="0 0 24 24" class="size-3.5 shrink-0 fill-none stroke-current" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
            <span class="truncate"><span data-campaign="servico">seu serviço</span> em <span data-campaign="cidade">sua cidade</span></span>
          </div>
        </div>

        <div class="p-5">
          <div class="flex items-center justify-between text-[11px] uppercase tracking-wider text-white/40">
            <span>Resultados locais</span>
            <span class="rounded-full bg-sky-500/15 px-2.5 py-1 font-semibold normal-case tracking-normal text-sky-300">Destaque</span>
          </div>

          <div class="mt-4 rounded-xl border border-sky-400/30 bg-sky-500/[0.08] p-4">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="font-title text-base font-semibold text-white" data-campaign="negocio">Seu negócio</p>
                <p class="mt-1 text-xs text-white/55"><span data-campaign="servico">Seu serviço</span> · <span data-campaign="cidade">Sua cidade</span></p>
              </div>
              <span class="shrink-0 rounded-full bg-emerald-500/15 px-2.5 py-1 text-[10px] font-semibold text-emerald-300">Aberto</span>
            </div>
            <div class="mt-3 flex items-center gap-1.5 text-[11px] text-amber-300">
              <span aria-hidden="true">★★★★★</span>
              <span class="text-white/45">4,9 (48 avaliações)</span>
            </div>
            <div class="mt-4 grid grid-cols-3 gap-2 text-center text-[11px] font-semibold text-sky-300">
              <span class="rounded-full border border-sky-400/20 bg-white/5 py-2">Ligar</span>
              <span class="rounded-full border border-sky-400/20 bg-white/5 py-2">Site</span>
              <span class="rounded-full border border-sky-400/20 bg-white/5 py-2">Rota</span>
            </div>
          </div>

          <div class="mt-3 space-y-2">
            <div class="rounded-xl border border-white/5 bg-white/[0.02] p-3">
              <div class="h-2 w-28 rounded-full bg-white/10"></div>
              <div class="mt-2 h-2 w-40 rounded-full bg-white/5"></div>
            </div>
            <div class="rounded-xl border border-white/5 bg-white/[0.02] p-3">
              <div class="h-2 w-24 rounded-full bg-white/10"></div>
              <div class="mt-2 h-2 w-36 rounded-full bg-white/5"></div>
            </div>
          </div>

          <p class="mt-4 text-center text-[10px] text-white/30">Exemplo ilustrativo</p>
        </div>
      </div>

      <div class="absolute bottom-0 left-4 right-4 rounded-xl border border-emerald-500/25 bg-[#0f1c24] p-4 shadow-xl shadow-black/40 sm:-left-6 sm:right-auto sm:w-72">
        <div class="flex items-center gap-2 text-[11px] font-semibold text-emerald-300">
          <span class="flex size-6 items-center justify-center rounded-full bg-emerald-500/15">
            <svg viewBox="0 0 24 24" class="size-3.5 fill-current"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-1.7-.1a13 13 0 0 1-6.5-5.8c-.5-.8-.8-1.7-.8-2.5 0-.9.5-1.5 1-1.9.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .6.4l.8 1.9c.1.2 0 .4-.1.5l-.4.5c-.2.2-.3.3-.1.6a9 9 0 0 0 4 3.4c.3.2.5.1.7-.1l.9-1c.2-.2.4-.2.6-.1l1.9.9c.2.1.4.2.4.3.1.2.1.7-.1 1.1l-.6 1Z"/></svg>
          </span>
          Novo contato pelo site
        </div>
        <p class="mt-2 text-xs leading-relaxed text-white/75">"Oi! Vi seu site no Google. Vocês atendem em <span data-campaign="cidade">minha cidade</span>?"</p>
        <p class="mt-2 text-[11px] font-semibold text-sky-300">Responder agora →</p>
      </div>
    </div>
  </div>
</section>

<section class="bg-surface py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-3xl text-center">
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-400">O problema</span>
      <h2 class="mt-3 font-title text-3xl text-white md:text-4xl">Indicação ajuda. Mas não deveria ser o seu único canal.</h2>
      <p class="mt-5 text-base leading-relaxed text-white/70 md:text-lg">
        Todo negócio construído por brasileiros fora do Brasil começa na confiança e na indicação. O problema é depender
        só dela para manter a agenda cheia.
      </p>
    </div>

    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {problems.map((problem) => (
        <li class="rounded-2xl border border-red-500/15 bg-red-500/[0.05] p-6">
          <span class="flex size-11 items-center justify-center rounded-xl bg-red-500/10 text-red-300">
            <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[problem.icon]} />
          </span>
          <h3 class="mt-4 text-lg font-semibold text-white">{problem.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/65">{problem.description}</p>
        </li>
      ))}
    </ul>

    <p class="mx-auto mt-10 max-w-2xl rounded-2xl border border-white/10 bg-white/[0.04] p-5 text-center text-sm leading-relaxed text-white/75">
      Enquanto isso, o cliente que procura por <span class="font-semibold text-white" data-campaign="servico">seu serviço</span> em
      <span class="font-semibold text-white" data-campaign="cidade">sua cidade</span> no Google acaba ligando para outro negócio.
    </p>
  </div>
</section>

<section id="solucao" class="py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-3xl text-center">
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-400">A solução Scalyns</span>
      <h2 class="mt-3 font-title text-3xl text-white md:text-4xl">Uma estrutura simples para ser encontrado e não perder contatos</h2>
      <p class="mt-5 text-base leading-relaxed text-white/70 md:text-lg">
        Site, Google e CRM trabalhando juntos — sem complicação e com acompanhamento em português.
      </p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {solutions.map((solution) => (
        <article class="group flex flex-col rounded-2xl border border-white/10 bg-white/[0.04] p-6 transition duration-300 hover:border-sky-500/50 hover:bg-white/[0.07] md:hover:-translate-y-1.5">
          <span class="flex size-11 items-center justify-center rounded-xl bg-sky-500/10 text-sky-400 transition group-hover:bg-sky-500/20">
            <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[solution.icon]} />
          </span>
          <h3 class="mt-4 text-lg font-semibold text-white transition group-hover:text-sky-300">{solution.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/65">{solution.description}</p>
          <ul class="mt-4 space-y-2 text-xs text-white/55">
            {solution.points.map((point) => (
              <li class="flex items-start gap-2">
                <span class="mt-1 size-1.5 shrink-0 rounded-full bg-sky-400/80"></span>
                {point}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a href="#contato" class="inline-block rounded-full bg-white px-8 py-3 font-semibold text-primary transition hover:-translate-y-0.5 hover:bg-gray-100">
        Quero essa estrutura para o meu negócio
      </a>
    </div>
  </div>
</section>

<section class="bg-surface py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-3xl text-center">
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-400">Como começar</span>
      <h2 class="mt-3 font-title text-3xl text-white md:text-4xl">Do primeiro contato ao site no ar em uma semana</h2>
      <p class="mt-5 text-base leading-relaxed text-white/70 md:text-lg">
        Um processo direto, sem burocracia e com uma pessoa do nosso time acompanhando você.
      </p>
    </div>

    <ol class="mt-12 grid gap-5 md:grid-cols-3">
      {steps.map((step, index) => (
        <li class="relative rounded-2xl border border-white/10 bg-white/[0.04] p-6">
          <span class="flex size-10 items-center justify-center rounded-full border border-sky-400/30 bg-sky-500/10 font-title text-sm font-bold text-sky-300">
            {String(index + 1).padStart(2, "0")}
          </span>
          <h3 class="mt-4 text-lg font-semibold text-white">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/65">{step.description}</p>
        </li>
      ))}
    </ol>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-white/60">
      <span class="flex items-center gap-2"><svg viewBox="0 0 24 24" class="size-4 fill-none stroke-emerald-400" stroke-width="2.5" set:html={icons.check} /> Sem contrato longo</span>
      <span class="flex items-center gap-2"><svg viewBox="0 0 24 24" class="size-4 fill-none stroke-emerald-400" stroke-width="2.5" set:html={icons.check} /> Atendimento direto em português</span>
      <span class="flex items-center gap-2"><svg viewBox="0 0 24 24" class="size-4 fill-none stroke-emerald-400" stroke-width="2.5" set:html={icons.check} /> Foco em contatos, não em cliques</span>
    </div>
  </div>
</section>

<section class="py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="relative overflow-hidden rounded-3xl border border-sky-500/25 bg-gradient-to-br from-primary via-[#1b2145] to-secondary p-8 shadow-2xl shadow-black/30 md:p-12">
      <div class="pointer-events-none absolute -right-24 -top-24 size-72 rounded-full bg-sky-500/10 blur-3xl" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-24 -left-24 size-72 rounded-full bg-fuchsia-500/10 blur-3xl" aria-hidden="true"></div>

      <div class="relative grid gap-10 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
        <div>
          <span class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-300">Pacotes Scalyns</span>
          <h2 class="mt-3 font-title text-3xl text-white md:text-4xl">Uma estrutura completa para começar a ser encontrado</h2>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-white/75">
            O essencial para o seu negócio aparecer no Google, receber contatos e responder rápido — sem contrato longo
            e com atendimento direto em português.
          </p>
          <ul class="mt-6 grid gap-3 text-sm text-white/80 sm:grid-cols-2">
            {offerItems.map((item) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-400">
                  <svg viewBox="0 0 24 24" class="size-3 fill-none stroke-current" stroke-width="3" set:html={icons.check} />
                </span>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/[0.06] p-6 backdrop-blur">
          <p class="text-xs font-semibold uppercase tracking-[0.15em] text-white/50">Pacotes a partir de</p>
          <p class="mt-2 font-title text-4xl font-bold text-white md:text-5xl">US$ 497</p>
          <p class="mt-2 text-sm text-white/60">sem contrato longo</p>
          <a href="#contato" class="mt-6 block rounded-full bg-white px-6 py-3 text-center font-semibold text-primary transition hover:-translate-y-0.5 hover:bg-gray-100">
            Agendar diagnóstico de 15 min
          </a>
          <p class="mt-3 text-center text-xs text-white/45">Atendimento direto em português</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="bg-surface py-16 lg:py-24">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 lg:grid-cols-[0.9fr_1.1fr]">
    <div>
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-400">Dúvidas frequentes</span>
      <h2 class="mt-3 font-title text-3xl text-white md:text-4xl">O que você precisa saber antes de começar</h2>
      <p class="mt-5 text-base leading-relaxed text-white/70">
