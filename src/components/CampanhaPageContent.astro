<script>
  document.addEventListener("DOMContentLoaded", () => {
    const params = new URLSearchParams(location.search);
    const clean = (value: string | null) => {
      const text = (value || "").trim();
      if (!text || text.includes("{{") || text.includes("}}")) return "";
      return text;
    };

    const name = clean(params.get("nome"));
    const service = clean(params.get("servico"));
    const city = clean(params.get("cidade"));
    const business = clean(params.get("negocio"));

    const replace = (key: string, value: string) => {
      if (!value) return;
      document.querySelectorAll(`[data-campaign="${key}"]`).forEach((element) => {
        element.textContent = value;
      });
    };

    replace("servico", service);
    replace("cidade", city);
    replace("negocio", business);

    if (name) {
      replace("nome", name);
      const greeting = document.querySelector("[data-campaign-greeting]");
      greeting?.classList.remove("hidden");
    }

    const whatsappButtons = document.querySelectorAll<HTMLAnchorElement>("[data-campaign-whatsapp]");
    if (whatsappButtons.length && (service || city)) {
      const message = `Olá! Vi a campanha da Scalyns e quero saber como aparecer no Google${service ? ` para ${service}` : ""}${city ? ` em ${city}` : ""}.`;
      whatsappButtons.forEach((button) => {
        const base = button.href.split("?")[0];
        button.href = `${base}?text=${encodeURIComponent(message)}`;
      });
    }

    const form = document.getElementById("scalynsContactForm") as HTMLFormElement | null;
    if (form) {
      if (name) {
        const firstName = form.querySelector<HTMLInputElement>('input[name="firstName"]');
        if (firstName) firstName.value = name;
      }

      const subject = form.querySelector<HTMLInputElement>('input[name="subject"]');
      if (subject && !subject.value) subject.value = "Quero ser encontrado no Google";

      const message = form.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
      if (message && !message.value) {
        const details = [
          "Quero saber como aparecer no Google",
          service ? `para ${service}` : "",
          city ? `em ${city}` : "",
        ].filter(Boolean);
        const extra = business ? ` Meu negócio é ${business}.` : "";
        message.value = `${details.join(" ")}.${extra}`;
      }
    }
  });
</script>
