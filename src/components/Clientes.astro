---
import { clientes } from "../data/clientes";
import { useTranslations, languages, type Lang } from "../i18n/ui";
import BrowserFrame from "./usables/BrowserFrame.astro";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const t = useTranslations(lang);
const home = languages[lang].homePath;
---

<section id="clientes" class="bg-surface py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-3xl text-center">
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-400">{t.clients.eyebrow}</span>
      <h2 class="mt-3 font-title text-3xl text-white md:text-4xl">{t.clients.title}</h2>
      <p class="mt-5 text-base leading-relaxed text-white/70 md:text-lg">{t.clients.subtitle}</p>
    </div>

    <div class="mt-10 flex flex-wrap justify-center gap-3" role="tablist" aria-label={t.clients.eyebrow}>
      {clientes.map((cliente, index) => (
        <button
          type="button"
          role="tab"
          data-client-tab={cliente.id}
          aria-selected={index === 0 ? "true" : "false"}
          aria-controls={`client-panel-${cliente.id}`}
          class={`rounded-full border px-5 py-2 text-sm font-semibold transition ${index === 0 ? "border-sky-400 bg-sky-500/15 text-white" : "border-white/15 text-white/70 hover:bg-white/5 hover:text-white"}`}
        >
          {cliente.nome}
        </button>
      ))}
    </div>

    {clientes.map((cliente, index) => (
      <div
        id={`client-panel-${cliente.id}`}
        data-client-panel={cliente.id}
        role="tabpanel"
        class={`mt-10 grid items-start gap-10 rounded-3xl border border-white/10 bg-white/[0.03] p-6 md:p-10 lg:grid-cols-2 ${index === 0 ? "" : "hidden"}`}
      >
        <div class="space-y-5">
          <BrowserFrame url={cliente.site ?? cliente.crm ?? "scalyns.com"} label={cliente.nome} monograma={cliente.monograma} cor={cliente.cor} imagem={cliente.preview} alt={`${t.clients.previewSoon} — ${cliente.nome}`} />
          <div class="flex flex-wrap gap-2">
            {cliente.metricas[lang].map((metrica) => (
              <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-white/75">{metrica}</span>
            ))}
          </div>
        </div>

        <div class="space-y-6">
          <div>
            <h3 class="font-title text-2xl text-white">{cliente.nome}</h3>
            <p class="mt-1 text-sm text-white/50">{cliente.segmento[lang]}</p>
          </div>

          <p class="text-sm leading-relaxed text-white/75">{cliente.descricao[lang]}</p>

          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wide text-white/45">{t.clients.gainsLabel}</h4>
            <ul class="mt-3 space-y-2 text-sm text-white/75">
              {cliente.ganhos[lang].map((ganho) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-400">
                    <svg viewBox="0 0 24 24" class="size-3 fill-none stroke-current" stroke-width="3"><path d="M5 13l4 4L19 7"></path></svg>
                  </span>
                  {ganho}
                </li>
              ))}
            </ul>
          </div>

          <div class="flex flex-wrap gap-3 pt-1">
            {cliente.site ? (
              <a href={cliente.site} target="_blank" rel="noopener noreferrer" class="rounded-full bg-white px-5 py-2.5 text-sm font-semibold text-primary transition hover:bg-gray-100">
                {t.clients.siteCta}
              </a>
            ) : null}
            {cliente.crm ? (
              <a href={cliente.crm} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10">
                {t.clients.crmCta}
              </a>
            ) : null}
            {cliente.instagram ? (
              <a href={cliente.instagram} target="_blank" rel="noopener noreferrer" class="rounded-full border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10">
                {t.clients.instagramCta}
              </a>
            ) : null}
            <a href={`${home}#contato`} class="rounded-full border border-transparent px-5 py-2.5 text-sm font-semibold text-sky-300 underline underline-offset-4 transition hover:text-sky-200">
              {t.clients.contactCta}
            </a>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const tabs = document.querySelectorAll("[data-client-tab]");
  const panels = document.querySelectorAll("[data-client-panel]");

  tabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const target = tab.getAttribute("data-client-tab");
      tabs.forEach((item) => {
        const active = item.getAttribute("data-client-tab") === target;
        item.setAttribute("aria-selected", active ? "true" : "false");
        item.classList.toggle("border-sky-400", active);
        item.classList.toggle("bg-sky-500/15", active);
        item.classList.toggle("text-white", active);
        item.classList.toggle("border-white/15", !active);
        item.classList.toggle("text-white/70", !active);
      });
      panels.forEach((panel) => {
        panel.classList.toggle("hidden", panel.getAttribute("data-client-panel") !== target);
      });
    });
  });
</script>
