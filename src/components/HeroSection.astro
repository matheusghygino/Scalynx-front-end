---
import { useTranslations, languages, type Lang } from "../i18n/ui";
import AppMockup from "./usables/AppMockup.astro";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const t = useTranslations(lang);
const home = languages[lang].homePath;

---

<section class="relative overflow-hidden bg-gradient-to-br from-primary via-[#1b2145] to-secondary pb-16 pt-28 text-white md:pb-24 md:pt-36">
  <div class="pointer-events-none absolute -left-40 top-10 size-[420px] rounded-full bg-blue-500/10 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-32 bottom-0 size-[380px] rounded-full bg-fuchsia-500/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-14 px-6 lg:grid-cols-[1.05fr_1fr]">
    <div>
      <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-white/75">
        {t.hero.eyebrow}
      </span>

      <h1 class="mt-6 max-w-xl text-4xl font-title font-bold leading-tight text-white md:text-[2.9rem]">
        {t.hero.title}
      </h1>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-white/80 md:text-lg">
        {t.hero.subtitle}
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="#plataforma" class="rounded-full bg-white px-7 py-3 font-semibold text-primary shadow-lg shadow-black/20 transition hover:-translate-y-0.5 hover:bg-gray-100">
          {t.hero.ctaPrimary}
        </a>
        <a href={`${home}#contato`} class="rounded-full border border-white/30 px-7 py-3 font-semibold text-white transition hover:bg-white/10">
          {t.hero.ctaSecondary}
        </a>
      </div>

      <dl class="mt-10 grid max-w-xl grid-cols-2 gap-x-6 gap-y-5 border-t border-white/10 pt-8 sm:grid-cols-4">
        {t.hero.stats.map((stat) => (
          <div>
            <dt class="text-2xl font-title font-bold text-white">{stat.value}</dt>
            <dd class="mt-1 text-xs leading-snug text-white/60">{stat.label}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="relative pb-8 pt-2">
      <AppMockup lang={lang} />
    </div>
  </div>
</section>
