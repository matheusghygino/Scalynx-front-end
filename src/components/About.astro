---
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const t = useTranslations(lang);
---

<section id="sobre" class="bg-surface py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="font-title text-3xl text-white md:text-4xl">{t.about.title}</h2>
      <p class="mt-6 text-base leading-relaxed text-white/75 md:text-lg md:text-justify">
        {t.about.text}
      </p>
    </div>

    <ul class="mx-auto mt-12 grid max-w-4xl gap-4 md:grid-cols-3">
      {t.about.points.map((point) => (
        <li class="flex items-start gap-3 rounded-2xl border border-white/10 bg-white/[0.04] p-5 text-sm leading-relaxed text-white/80">
          <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-emerald-500/15 text-emerald-400">
            <svg viewBox="0 0 24 24" class="size-3.5 fill-none stroke-current" stroke-width="3"><path d="M5 13l4 4L19 7"></path></svg>
          </span>
          {point}
        </li>
      ))}
    </ul>
  </div>
</section>
