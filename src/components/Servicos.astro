---
import { useTranslations, languages, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const t = useTranslations(lang);
const home = languages[lang].homePath;

const icons: Record<string, string> = {
  globe: '<circle cx="12" cy="12" r="9"></circle><path d="M3 12h18M12 3c2.5 2.6 3.8 5.7 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.7-3.8-9S9.5 5.6 12 3Z"></path>',
  palette: '<path d="M12 3a9 9 0 1 0 0 18c1.2 0 2-.9 2-2 0-.6-.2-1-.6-1.4-.4-.4-.6-.9-.6-1.4 0-1.1.9-2 2-2h1.7A4.5 4.5 0 0 0 21 9.7C21 5.9 16.9 3 12 3Z"></path><circle cx="7.5" cy="10.5" r="1.2"></circle><circle cx="12" cy="7.5" r="1.2"></circle><circle cx="16.5" cy="10.5" r="1.2"></circle>',
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.2" cy="6.8" r="1"></circle>',
  target: '<circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.4"></circle>',
  chat: '<path d="M21 12a8 8 0 0 1-8 8H5l-2 2V12a9 9 0 0 1 9-9h1a8 8 0 0 1 8 8Z"></path><path d="M8 11h8M8 15h5"></path>',
  bolt: '<path d="M13 2 4 14h6l-1 8 9-12h-6l1-8Z"></path>',
};
---

<section id="servicos" class="py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="mx-auto max-w-3xl text-center">
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-sky-400">{t.services.eyebrow}</span>
      <h2 class="mt-3 font-title text-3xl text-white md:text-4xl">{t.services.title}</h2>
      <p class="mt-5 text-base leading-relaxed text-white/70 md:text-lg">{t.services.subtitle}</p>
    </div>

    <!-- Os mesmos cards formam um carrossel no mobile e uma grade no desktop. -->
    <div class="-mx-6 mt-12 flex snap-x snap-mandatory gap-4 overflow-x-auto px-6 pb-4 md:mx-0 md:grid md:snap-none md:grid-cols-2 md:gap-6 md:overflow-visible md:p-0 lg:grid-cols-3" role="list">
      {t.services.items.map((service) => (
        <article role="listitem" class="group w-[86%] shrink-0 snap-start rounded-2xl border border-white/10 bg-white/[0.04] p-6 transition duration-300 hover:border-sky-500/50 hover:bg-white/[0.07] md:w-auto md:p-7 md:hover:-translate-y-1.5 md:hover:shadow-2xl md:hover:shadow-sky-950/40">
          <span class="flex size-11 items-center justify-center rounded-xl bg-sky-500/10 text-sky-400 transition group-hover:bg-sky-500/20 md:size-12">
            <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current md:size-6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[service.icon]} />
          </span>
          <h3 class="mt-4 text-lg font-semibold text-white transition group-hover:text-sky-300 md:mt-5">{service.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/70 md:mt-3">{service.description}</p>
          <ul class="mt-4 space-y-1.5 text-xs text-white/55 md:mt-5 md:space-y-2">
            {service.points.map((point) => <li class="flex items-start gap-2"><span class="mt-1 size-1.5 shrink-0 rounded-full bg-sky-400/80"></span>{point}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a href={`${home}#contato`} class="inline-block rounded-full bg-white px-8 py-3 font-semibold text-primary transition hover:-translate-y-0.5 hover:bg-gray-100">
        {t.services.cta}
      </a>
    </div>
  </div>
</section>
