---
import { Image } from "astro:assets";
import logo from "../assets/logo_scalyns.png";
import { contact, languages, useTranslations, whatsapp, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const t = useTranslations(lang);
const home = languages[lang].homePath;
const anoAtual = new Date().getFullYear();

const navLinks = [
  { href: `${home}#sobre`, label: t.nav.about },
  { href: `${home}#servicos`, label: t.nav.services },
  { href: lang === "pt" ? "/crm" : "/en/crm", label: t.nav.crm },
  { href: `${home}#clientes`, label: t.nav.clients },
  { href: `${home}#contato`, label: t.nav.contact },
];
---

<footer class="mt-20 border-t border-white/5 bg-gradient-to-r from-primary to-secondary py-12 text-white">
  <div class="mx-auto grid max-w-6xl grid-cols-2 gap-10 px-6 md:grid-cols-4">
    <div class="col-span-2 md:col-span-1">
      <a href={home} class="mb-4 inline-block">
        <Image src={logo} alt="Scalyns" width={210} height={64} format="avif" quality={80} class="h-12 w-auto" loading="lazy" decoding="async" />
      </a>
      <p class="text-sm font-body leading-relaxed text-white/70">{t.footer.tagline}</p>
    </div>

    <div>
      <h3 class="mb-4 text-base font-semibold">{t.footer.navigation}</h3>
      <ul class="space-y-2 text-sm text-white/80">
        {navLinks.map((link) => <li><a href={link.href} class="transition hover:text-white hover:underline">{link.label}</a></li>)}
      </ul>
    </div>

    <div>
      <h3 class="mb-4 text-base font-semibold">{t.footer.contact}</h3>
      <ul class="space-y-2 text-sm text-white/80">
        <li><a href={`mailto:${contact.email}`} class="break-all transition hover:text-white hover:underline">{contact.email}</a></li>
        <li>
          <a href={whatsapp.link} target="_blank" rel="noopener noreferrer" class="transition hover:text-white hover:underline">
            {t.footer.whatsappLabel}: {whatsapp.phoneDisplay}
          </a>
        </li>
        <li class="text-white/60">{t.contact.address}</li>
      </ul>
      <div class="mt-4 flex items-center gap-4">
        <a href={contact.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="transition hover:opacity-80">
          <svg class="h-5 w-5 fill-white" viewBox="0 0 24 24"><path d="M7.5 2h9A5.5 5.5 0 0 1 22 7.5v9A5.5 5.5 0 0 1 16.5 22h-9A5.5 5.5 0 0 1 2 16.5v-9A5.5 5.5 0 0 1 7.5 2Zm0 2A3.5 3.5 0 0 0 4 7.5v9A3.5 3.5 0 0 0 7.5 20h9a3.5 3.5 0 0 0 3.5-3.5v-9A3.5 3.5 0 0 0 16.5 4h-9Zm4.5 2.5a5.5 5.5 0 1 1 0 11a5.5 5.5 0 0 1 0-11Zm0 2a3.5 3.5 0 1 0 0 7a3.5 3.5 0 0 0 0-7Zm5.25-.75a.75.75 0 1 1-1.5 0a.75.75 0 0 1 1.5 0Z"/></svg>
        </a>
        {contact.linkedin ? (
          <a href={contact.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="transition hover:opacity-80">
            <svg class="h-5 w-5 fill-white" viewBox="0 0 24 24"><path d="M19 3A2 2 0 0 1 21 5v14a2 2 0 0 1-2 2h-3v-6.5c0-1.1-.4-2-1.5-2s-1.5.9-1.5 2V21h-3v-9h3v1.3c.4-.8 1.2-1.3 2.2-1.3c2 0 2.8 1.5 2.8 3.5V21H19V3ZM5 9H8v12H5V9Zm1.5-6A1.5 1.5 0 1 1 5 4.5A1.5 1.5 0 0 1 6.5 3Z"/></svg>
          </a>
        ) : null}
      </div>
    </div>

    <div>
      <h3 class="mb-4 text-base font-semibold">{t.footer.languageLabel}</h3>
      <div class="flex flex-wrap items-center gap-2 text-sm">
        <a href="/?lang=pt" data-set-lang="pt" class={`rounded-full px-3 py-1 ${lang === "pt" ? "bg-white text-primary" : "border border-white/30 text-white/80 hover:text-white"}`}>Português</a>
        <a href="/en/?lang=en" data-set-lang="en" class={`rounded-full px-3 py-1 ${lang === "en" ? "bg-white text-primary" : "border border-white/30 text-white/80 hover:text-white"}`}>English</a>
      </div>
    </div>
  </div>

  <div class="mt-12 flex flex-col items-center gap-2 text-center text-sm text-white/50">
    <span>&copy; {anoAtual} Scalyns. {t.footer.rights}</span>
  </div>
</footer>
