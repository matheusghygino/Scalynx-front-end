---
import AppMockup from "./usables/AppMockup.astro";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
}

const { lang = "pt" } = Astro.props;
const t = useTranslations(lang);
const crmPath = lang === "pt" ? "/crm" : "/en/crm";
---

<section id="crm" class="py-16 lg:py-24">
  <div class="mx-auto max-w-6xl px-6">
    <div class="grid items-center gap-14 lg:grid-cols-[1fr_1.05fr]">
      <div class="order-2 lg:order-1">
        <span class="text-xs font-semibold uppercase tracking-[0.2em] text-emerald-400">{t.crmHome.eyebrow}</span>
        <h2 class="mt-3 font-title text-3xl text-white md:text-4xl">{t.crmHome.title}</h2>
        <p class="mt-5 text-base leading-relaxed text-white/70 md:text-lg">{t.crmHome.subtitle}</p>

        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href={`${crmPath}#contato`} class="rounded-full bg-white px-7 py-3 font-semibold text-primary transition hover:-translate-y-0.5 hover:bg-gray-100">
            {t.crmHome.demoCta}
          </a>
          <a href={crmPath} class="rounded-full border border-white/25 px-7 py-3 font-semibold text-white transition hover:bg-white/10">
            {t.crmHome.learnCta}
          </a>
        </div>
      </div>

      <div class="order-1 lg:order-2">
        <AppMockup lang={lang} />
      </div>
    </div>

    <ul class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {t.crmHome.features.map((feature) => (
        <li class="rounded-2xl border border-white/10 bg-white/[0.04] p-6 transition hover:border-emerald-500/40 hover:bg-white/[0.07]">
          <span class="flex size-9 items-center justify-center rounded-lg bg-emerald-500/15 text-emerald-400">
            <svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current" stroke-width="3"><path d="M5 13l4 4L19 7"></path></svg>
          </span>
          <h3 class="mt-4 font-semibold text-white">{feature.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/65">{feature.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
