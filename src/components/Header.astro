---
import { Image } from "astro:assets";
import logo from "../assets/logo_scalyns.png";
import { languages, useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang?: Lang;
  currentPath?: string;
}

const { lang = "pt", currentPath = "/" } = Astro.props;
const t = useTranslations(lang);
const home = languages[lang].homePath;

const enPath = lang === "pt" ? (currentPath === "/" ? "/en/" : `/en${currentPath}`) : currentPath;
const ptPath = lang === "en" ? (currentPath.replace(/^\/en/, "") || "/") : currentPath;

const links = [
  { href: `${home}#sobre`, label: t.nav.about },
  { href: `${home}#servicos`, label: t.nav.services },
  { href: lang === "pt" ? "/crm" : "/en/crm", label: t.nav.crm },
  { href: lang === "pt" ? "/erp" : "/en/erp", label: t.nav.erp },
  { href: `${home}#clientes`, label: t.nav.clients },
];
---

<header
  id="siteHeader"
  class="fixed left-0 top-0 z-50 w-full bg-gradient-to-r from-primary to-secondary shadow-lg shadow-black/20 transition-transform duration-300"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 md:px-6">
    <a href={home} class="flex items-center" aria-label="Scalyns">
      <Image src={logo} alt="Scalyns" width={210} height={64} format="avif" quality={80} class="h-11 w-auto md:h-12" loading="eager" decoding="async" />
    </a>

    <button
      id="menuButton"
      class="z-50 focus:outline-none lg:hidden"
      aria-controls="mobileMenu"
      aria-expanded="false"
      aria-label={t.nav.menu}
    >
      <svg id="menuIcon" class="h-7 w-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>

    <nav class="hidden items-center gap-6 text-sm font-semibold lg:flex" aria-label={lang === "pt" ? "Principal" : "Main navigation"}>
      {links.map((link) => <a href={link.href} class="text-white/85 transition-colors hover:text-white">{link.label}</a>)}
      <div class="flex items-center gap-1 rounded-full border border-white/20 p-0.5" aria-label={t.nav.languageLabel}>
        <a href={`${ptPath}?lang=pt`} data-set-lang="pt" aria-current={lang === "pt" ? "true" : undefined} class={`rounded-full px-2.5 py-1 text-xs transition ${lang === "pt" ? "bg-white text-primary" : "text-white/70 hover:text-white"}`}>PT</a>
        <a href={`${enPath}?lang=en`} data-set-lang="en" aria-current={lang === "en" ? "true" : undefined} class={`rounded-full px-2.5 py-1 text-xs transition ${lang === "en" ? "bg-white text-primary" : "text-white/70 hover:text-white"}`}>EN</a>
      </div>
      <a href={`${home}#contato`} class="rounded-full bg-white px-5 py-2 font-semibold text-primary transition hover:bg-gray-100">
        {t.nav.cta}
      </a>
    </nav>
  </div>

  <div
    id="mobileMenu"
    class="fixed left-0 top-0 z-40 flex h-screen w-full -translate-x-full flex-col items-center justify-center bg-gradient-to-b from-primary to-secondary text-white opacity-0 transition-all duration-500 ease-in-out lg:hidden"
  >
    <nav class="flex flex-col items-center space-y-6 text-center text-lg font-semibold">
      {links.map((link) => <a href={link.href} class="mobile-link">{link.label}</a>)}
      <a href={`${home}#contato`} class="mobile-link rounded-full bg-white/10 px-6 py-2 transition hover:bg-white/20">{t.nav.cta}</a>
      <div class="flex items-center gap-2 pt-2 text-sm">
        <a href={`${ptPath}?lang=pt`} data-set-lang="pt" class={`rounded-full px-4 py-1.5 ${lang === "pt" ? "bg-white text-primary" : "border border-white/30 text-white/80"}`}>PT</a>
        <a href={`${enPath}?lang=en`} data-set-lang="en" class={`rounded-full px-4 py-1.5 ${lang === "en" ? "bg-white text-primary" : "border border-white/30 text-white/80"}`}>EN</a>
      </div>
    </nav>
  </div>
</header>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const header = document.getElementById("siteHeader");
    const menuButton = document.getElementById("menuButton");
    const mobileMenu = document.getElementById("mobileMenu");
    const mobileLinks = mobileMenu?.querySelectorAll("a") || [];
    let lastScrollY = window.scrollY;
    let isHidden = false;
    let isMenuOpen = false;

    function openMobileMenu() {
      mobileMenu?.classList.remove("-translate-x-full", "opacity-0");
      mobileMenu?.classList.add("translate-x-0", "opacity-100");
      menuButton?.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      isMenuOpen = true;
    }

    function closeMobileMenu() {
      mobileMenu?.classList.add("-translate-x-full", "opacity-0");
      mobileMenu?.classList.remove("translate-x-0", "opacity-100");
      menuButton?.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      isMenuOpen = false;
    }

    window.addEventListener("scroll", () => {
      const scrollY = window.scrollY;
      if (scrollY > lastScrollY && scrollY > 140 && !isHidden) {
        header?.classList.add("-translate-y-full");
        isHidden = true;
      } else if (scrollY < lastScrollY && isHidden) {
        header?.classList.remove("-translate-y-full");
        isHidden = false;
      }
      lastScrollY = scrollY;
    });

    document.addEventListener("mousemove", (event) => {
      if (event.clientY < 60) {
        header?.classList.remove("-translate-y-full");
        isHidden = false;
      }
    });

    menuButton?.addEventListener("click", () => (isMenuOpen ? closeMobileMenu() : openMobileMenu()));

    mobileLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        const href = link.getAttribute("href") || "";
        const hash = href.includes("#") ? href.split("#")[1] : "";
        if (!hash) return;
        let samePage = href.startsWith("#");
        try {
          samePage = samePage || new URL(href, location.href).pathname === location.pathname;
        } catch {
          samePage = true;
        }
        if (!samePage) return;
        event.preventDefault();
        closeMobileMenu();
        window.setTimeout(() => {
          document.getElementById(hash)?.scrollIntoView({ behavior: "smooth", block: "start" });
          history.replaceState(null, "", `${location.pathname}#${hash}`);
        }, 260);
      });
    });

    document.querySelectorAll("[data-set-lang]").forEach((el) => {
      el.addEventListener("click", () => {
        try {
          localStorage.setItem("scalyns_lang", el.getAttribute("data-set-lang") || "pt");
        } catch {
          /* storage may be unavailable */
        }
      });
    });

    window.addEventListener("hashchange", () => {
      if (isMenuOpen) closeMobileMenu();
    });
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
  }
  section {
    scroll-margin-top: 90px;
  }
</style>
