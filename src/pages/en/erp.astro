---
import Layout from "../../layout/Layout.astro";
import ErpPageContent from "../../components/ErpPageContent.astro";
import { useTranslations } from "../../i18n/ui";
const t = useTranslations("en");
const software = { "@context": "https://schema.org", "@type": "SoftwareApplication", name: "Scalyns ERP", applicationCategory: "BusinessApplication", operatingSystem: "Web", url: "https://scalyns.com/en/erp", description: t.meta.erpDescription, inLanguage: "en", featureList: "Customers, vendors, catalog, quotes, orders, invoices, expenses, inventory and dashboard", publisher: { "@type": "Organization", name: "Scalyns", url: "https://scalyns.com" } };
---
<Layout lang="en" title={t.meta.erpTitle} description={t.meta.erpDescription} altPath="/erp" structuredData={[software]}><ErpPageContent lang="en" /></Layout>
